# .env.example
# Copy to .env and fill in real values BY HAND. Never let an agent write here.
# .env must be gitignored. Verify in a private browser window before submitting.

# ---- Database ----
# Local Postgres connection string, or your hosted provider's pooled URL.
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# ---- Session / crypto ----
# Random 32+ byte secret. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# ---- App ----
# Used for building links in emails (reset password, verification).
APP_URL="http://localhost:3000"
NODE_ENV="development"
